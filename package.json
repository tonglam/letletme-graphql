{
	"name": "letletme-graphql",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.0",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun src/index.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"coverage:critical": "bun scripts/check-critical-coverage.ts",
		"test:watch": "bun test --watch tests",
		"contract:check": "bun scripts/check-database-contract.ts",
		"data:contract:check": "bun scripts/check-data-main-compatibility.ts",
		"redis:check": "bun scripts/check-redis-connectivity.ts",
		"rate-limit:report": "bun scripts/rate-limit-report.ts",
		"rate-limit:serving-process-check": "bun scripts/rate-limit-serving-process-check.ts",
		"rate-limit:profile": "bun scripts/generate-rate-limit-profile.ts",
		"rate-limit:profile:v4": "bun scripts/generate-rate-limit-profile-v4.ts",
		"rate-limit:load": "bun scripts/rate-limit-load.ts",
		"live-match:capacity": "bun scripts/live-match-capacity.ts",
		"rate-limit:observe": "bun scripts/build-rate-limit-observation.ts",
		"rate-limit:observe:v4": "bun scripts/build-rate-limit-observation-v4.ts",
		"rate-limit:p0-probe": "bun scripts/rate-limit-p0-probe.ts",
		"layers:check": "bun scripts/check-layer-dependencies.ts",
		"docs:check": "bun scripts/check-domain-manifest.ts",
		"deprecation:check": "bun scripts/check-deprecation-manifest.ts",
		"lint": "eslint src tests scripts --max-warnings=0",
		"lint:fix": "eslint src tests scripts --fix",
		"format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\""
	},
	"dependencies": {
		"@apollo/server": "5.5.1",
		"@graphql-tools/schema": "^10.0.38",
		"graphql": "^16.14.2",
		"graphql-depth-limit": "^1.1.0",
		"graphql-scalars": "^2.0.0",
		"ioredis": "^5.11.1",
		"pg": "^8.22.0",
		"pino": "^10.3.1",
		"prom-client": "^15.1.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/graphql-depth-limit": "^1.1.6",
		"@types/node": "26.4.1",
		"@types/pg": "^8.20.0",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"bun-types": "^1.4.0",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.5",
		"typescript": "5.9.3"
	},
	"overrides": {
		"@protobufjs/utf8": "1.1.1",
		"brace-expansion": "5.0.9",
		"flatted": "3.4.2",
		"picomatch": "4.0.4"
	}
}
