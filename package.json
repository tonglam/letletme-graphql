{
	"name": "letletme-graphql",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun src/index.ts",
		"test": "bun test",
		"test:watch": "bun test --watch src",
		"migrate": "bun scripts/migrate.ts",
		"migrate:status": "bun scripts/migrate.ts --status",
		"preflight:snapshot": "bun scripts/preflight-snapshot.ts",
		"seed:mini-program-notice": "bun scripts/seed-mini-program-notice-redis.ts",
		"lint": "eslint src tests scripts",
		"lint:fix": "eslint src tests scripts --fix",
		"format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\""
	},
	"dependencies": {
		"@apollo/server": "5.5.1",
		"@graphql-tools/schema": "^10.0.38",
		"@supabase/supabase-js": "^2.110.7",
		"graphql": "^17.0.2",
		"graphql-depth-limit": "^1.1.0",
		"graphql-scalars": "^1.25.0",
		"ioredis": "^5.11.1",
		"pg": "^8.22.0",
		"pino": "^10.3.1",
		"prom-client": "^15.1.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/graphql-depth-limit": "^1.1.6",
		"@types/pg": "^8.20.0",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"bun-types": "^1.3.14",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.5"
	},
	"overrides": {
		"@protobufjs/utf8": "1.1.1",
		"brace-expansion": "5.0.8",
		"flatted": "3.4.2",
		"picomatch": "4.0.4"
	}
}
