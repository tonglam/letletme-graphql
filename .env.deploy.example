SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://user:pass@host:5432/db
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
PORT=4000
LOG_LEVEL=info
CACHE_TTL_SECONDS=60
JWT_SECRET=your_jwt_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BACKEND_PROXY_SECRET=shared_secret_with_letletme_web
GRAPHQL_AUTH_MODE=enforce
METRICS_TOKEN=metrics_scrape_token
APP_URL=https://api.letletme.top
CORS_ORIGIN=https://www.letletme.top
CORS_CREDENTIALS=true
WECHAT_APPID=your_wechat_appid
WECHAT_APPSECRET=your_wechat_appsecret
WECHAT_API_SESSION_TTL_SECONDS=2592000
