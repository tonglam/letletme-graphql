SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://user:pass@host:5432/db
# Deployment-only DDL connection. Required in production and must not be the runtime DATABASE_URL.
MIGRATIONS_DATABASE_URL=postgresql://migration_user:pass@host:5432/db
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
PORT=4000
LOG_LEVEL=info
CACHE_TTL_SECONDS=60
NODE_ENV=production
BACKEND_PROXY_SECRET=generate_a_shared_random_value_of_at_least_32_bytes
GRAPHQL_SERVICE_TOKEN=generate_an_independent_random_value_of_at_least_32_bytes
# Keep false during the measured Mini Program compatibility phase; set true only
# after the accepted release records seven days without unsigned client traffic.
REQUIRE_SIGNED_WEB_INGRESS=false
GRAPHQL_AUTH_MODE=enforce
METRICS_TOKEN=metrics_scrape_token
CORS_ORIGIN=https://www.letletme.top
CORS_CREDENTIALS=true
TRUSTED_PROXY_HOPS=0
LIVE_POINTS_V2=false
LEGACY_WECHAT_ISSUANCE_ENABLED=false
# Empty disables validation. Never extend without a recorded rollback decision.
LEGACY_AUTH_VALIDATION_UNTIL=
WECHAT_APPID=your_wechat_appid
WECHAT_APPSECRET=your_wechat_appsecret
WECHAT_API_SESSION_TTL_SECONDS=2592000
