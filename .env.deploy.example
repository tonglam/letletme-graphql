# Read-only login that inherits letletme_graphql_reader. It must not inherit any writer role.
DATABASE_URL=postgresql://letletme_graphql_runtime.project_ref:pass@host:5432/db
DATABASE_POOL_MAX=5
DATABASE_STATEMENT_TIMEOUT_MS=12000
REDIS_URL=rediss://primary-redis.example:6379
RATE_LIMIT_REDIS_URL=rediss://rate-limit-redis.example:6379
PORT=4000
LOG_LEVEL=info
NODE_ENV=production
BACKEND_PROXY_SECRET=generate_a_shared_random_value_of_at_least_32_bytes
GRAPHQL_SERVICE_TOKEN=generate_an_independent_random_value_of_at_least_32_bytes
METRICS_TOKEN=metrics_scrape_token
CORS_ORIGIN=https://www.letletme.top
GRAPHQL_RATE_LIMIT_MODE=shadow-v3
# Required. Query.entryLookup FPL fallback enqueues Data persist.
LETLETME_DATA_URL=http://host.docker.internal:3000
LETLETME_DATA_API_KEY=replace_with_data_service_api_key
FULL_FIELD_LIVE_BOARD_ENABLED=false
