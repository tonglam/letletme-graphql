# Read-only login that inherits letletme_graphql_reader. It must not inherit any writer role.
DATABASE_URL=postgresql://letletme_graphql_runtime.project_ref:pass@host:5432/db
DATABASE_POOL_MAX=5
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
PORT=4000
LOG_LEVEL=info
NODE_ENV=development
BACKEND_PROXY_SECRET=shared_secret_with_letletme_web
# Independent 32+ byte server-to-server credential for cached public Web reads.
GRAPHQL_SERVICE_TOKEN=shared_graphql_service_token
METRICS_TOKEN=metrics_scrape_token
TRUSTED_PROXY_HOPS=0
GRAPHQL_BROWSER_INGRESS_RATE_LIMIT=120
GRAPHQL_AUTHENTICATED_RATE_LIMIT=300
GRAPHQL_ANONYMOUS_RATE_LIMIT=120

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com  # Comma-separated or * for all
CORS_CREDENTIALS=true  # Set to true if using cookies/auth
