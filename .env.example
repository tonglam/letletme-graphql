SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://user:pass@host:5432/db
# Deployment-only DDL connection. Required in production and must not be the runtime DATABASE_URL.
MIGRATIONS_DATABASE_URL=postgresql://migration_user:pass@host:5432/db
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
PORT=4000
LOG_LEVEL=info
CACHE_TTL_SECONDS=60
NODE_ENV=development
BACKEND_PROXY_SECRET=shared_secret_with_letletme_web
# Independent 32+ byte server-to-server credential for cached public Web reads.
GRAPHQL_SERVICE_TOKEN=shared_graphql_service_token
REQUIRE_SIGNED_WEB_INGRESS=false
GRAPHQL_AUTH_MODE=enforce
METRICS_TOKEN=metrics_scrape_token
TRUSTED_PROXY_HOPS=0
LIVE_POINTS_V2=false
LEGACY_WECHAT_ISSUANCE_ENABLED=false
# Set explicitly to dual-verifier deployment time + 30 days. Empty disables legacy validation.
LEGACY_AUTH_VALIDATION_UNTIL=

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com  # Comma-separated or * for all
CORS_CREDENTIALS=true  # Set to true if using cookies/auth

# WeChat Mini Program
WECHAT_APPID=your_wechat_appid
WECHAT_APPSECRET=your_wechat_appsecret
WECHAT_API_SESSION_TTL_SECONDS=2592000
