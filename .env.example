SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://user:pass@host:5432/db
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
PORT=4000
LOG_LEVEL=info
CACHE_TTL_SECONDS=60
NODE_ENV=development
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me
BETTER_AUTH_URL=http://localhost:4000
BACKEND_PROXY_SECRET=shared_secret_with_letletme_web
GRAPHQL_AUTH_MODE=enforce
METRICS_TOKEN=metrics_scrape_token

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com  # Comma-separated or * for all
CORS_CREDENTIALS=true  # Set to true if using cookies/auth

# WeChat Mini Program
WECHAT_APPID=your_wechat_appid
WECHAT_APPSECRET=your_wechat_appsecret
WECHAT_API_SESSION_TTL_SECONDS=2592000
