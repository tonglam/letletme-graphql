# Read-only login that inherits letletme_graphql_reader. It must not inherit any writer role.
DATABASE_URL=postgresql://letletme_graphql_runtime.project_ref:pass@host:5432/db
DATABASE_POOL_MAX=2
DATABASE_STATEMENT_TIMEOUT_MS=12000
REDIS_URL=redis://127.0.0.1:6379
# Use a separate Redis endpoint for rate-limit/admission state in production.
RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6380
PORT=4000
LOG_LEVEL=info
NODE_ENV=development
DEPLOY_SHA=unknown
BACKEND_PROXY_SECRET=shared_secret_with_letletme_web
# Independent 32+ byte server-to-server credential for cached public Web reads.
GRAPHQL_SERVICE_TOKEN=shared_graphql_service_token
METRICS_TOKEN=metrics_scrape_token
# Versioned admission profile. Use enforce-v3/enforce-v4 only after the
# matching capacity evidence has been reviewed and committed.
GRAPHQL_RATE_LIMIT_MODE=shadow-v4
# CORS Configuration
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com  # Comma-separated or * for all

# Query.entryLookup FPL fallback enqueues Data persist. Required in production.
LETLETME_DATA_URL=
LETLETME_DATA_API_KEY=
FULL_FIELD_LIVE_BOARD_ENABLED=false
